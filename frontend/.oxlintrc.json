{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every category except style, restriction and nursery is an error, with
  // type-aware rules on (oxlint --type-aware, backed by typescript-go). Rules
  // below are only turned off or tuned where they don't fit a React + Vite app;
  // each says why.
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "promise",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    // The automatic JSX runtime doesn't need React in scope.
    "react/react-in-jsx-scope": "off",
    // Can't be met with React props and DOM types, which are mutable by design.
    "typescript/prefer-readonly-parameter-types": "off",
    // Inline handlers and objects only cost re-renders in memoised children,
    // and nothing here is memoised; React Compiler will handle it.
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    // API responses are cast to their types after the server validated them;
    // parsing every response with a schema library is out of scope.
    "typescript/no-unsafe-type-assertion": "off",
    // Size metrics, not bugs: page components are long by nature.
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "import/max-dependencies": "off",
    "eslint/no-inline-comments": "off",
    // Effects that set loading state around a fetch are intended here.
    "react/set-state-in-effect": "off",
    // tsconfig's noImplicitReturns already checks this, and the rule conflicts
    // with unicorn/no-useless-undefined in effects that return a cleanup.
    "typescript/consistent-return": "off",
    // Same intent as no-misused-promises below, which allows async JSX handlers.
    "typescript/strict-void-return": "off",

    // async () => {} on onClick/onSubmit is fine; React ignores the promise.
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    // onClick={() => setOpen(false)} returns void by design.
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    // Nullable strings and booleans in conditions ({error && ...}) are idiomatic;
    // nullable numbers stay strict because 0 is falsy.
    "typescript/strict-boolean-expressions": [
      "error",
      { "allowNullableBoolean": true, "allowNullableString": true }
    ],
    // x || 'fallback' on strings deliberately treats '' as missing.
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    // x == null checks null and undefined together.
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    // Side-effect imports of styles and fonts.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@fontsource-variable/**"] }]
  },
  "overrides": [
    {
      // shadcn/ui code as generated by `shadcn add`, only run through Prettier
      // (sonner.tsx also reads the console's own theme provider). It is
      // vendored, not hand-written: staying close to upstream lets later
      // `shadcn add --overwrite` runs apply cleanly, so the rules its upstream
      // style breaks are off here instead of patched in place. Content arrives
      // through props, variants are exported next to components, ARIA roles
      // sit on divs on purpose (role="group" on an input group, role="status"
      // on a spinner), and context values are built inline.
      "files": ["src/components/ui/**", "src/hooks/use-mobile.ts"],
      "rules": {
        "jsx-a11y/heading-has-content": "off",
        "jsx-a11y/anchor-has-content": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "react/only-export-components": "off",
        "react/jsx-no-constructed-context-values": "off",
        "react/no-array-index-key": "off",
        "react/purity": "off",
        "eslint/eqeqeq": "off",
        "eslint/no-shadow": "off",
        "unicorn/explicit-length-check": "off",
        "unicorn/no-useless-undefined": "off",
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/prefer-nullish-coalescing": "off"
      }
    },
    {
      // An inline SVG logo needs role="img"; an <img> can't style its paths with theme colours.
      "files": ["src/components/WGKeeperLogo.tsx", "src/components/WGKeeperMark.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    }
  ]
}

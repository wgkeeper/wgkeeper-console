# Settings for docker-compose.yml. Copy to console.env and fill in:
#   cp console.env.example console.env && chmod 600 console.env
# Every variable: docs/configuration.md

# Required. Signs sessions and encrypts stored node API keys. Generate once
# (openssl rand -hex 32) and back it up: if it changes, every session ends and
# the stored node API keys can't be decrypted.
SECRET_KEY=

# Required on the first start: the password of the "admin" user. You are
# asked to change it at the first login.
BOOTSTRAP_ADMIN_PASSWORD=

# false while the console is reached over plain HTTP (the loopback port or an
# SSH tunnel). The proxy examples set it to true.
COOKIE_SECURE=false

# Log format: text or json
# LOG_FORMAT=text

# Prometheus metrics on a separate port, off when unset (docs/metrics.md).
# METRICS_PORT=9100
# METRICS_TOKEN=
